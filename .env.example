BOT_TOKEN=replace_with_token_from_BotFather
# Optional outside the Portainer stack. The stack defaults to Throne in network vpn.
# TELEGRAM_PROXY=socks5h://throne:2080
# HTTPS_PROXY=http://proxy:3128
# ALL_PROXY=socks5h://proxy:1080
# Optional host port (Docker or direct Python).
# HTTP_PORT=8787
# Direct Python only; Compose configures these inside the container.
# HTTP_HOST=127.0.0.1
# STATE_FILE=/absolute/path/to/bot.sqlite3
